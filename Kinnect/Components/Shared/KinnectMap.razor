@using System.Net
@using LeafletForBlazor
@implements IDisposable
@using static LeafletForBlazor.Map
@using static LeafletForBlazor.techs.maps.Leaflet

<div class="kinnect-map @(Mini ? "kinnect-map-mini" : null)" @ref="root">
    <Map @ref="map" loadParameters="@parameters" height="100%" width="100%" OnAfterMapLoaded="ShowPinsAsync" />
</div>

@code {
    [Inject]
    public IJSRuntime Js { get; set; } = default!;

    private DotNetObjectReference<KinnectMap>? self;

    private readonly LoadParameters parameters = new()
    {
        location = new Location { latitude = -34.9285, longitude = 138.6007 },
        zoomLevel = 2,
    };

    private LeafletForBlazor.Map? map;
    private ElementReference root;
    private bool mapReady;
    private bool disposed;
    private int drawVersion;

    [Parameter]
    public IReadOnlyList<MapPinDto> Pins { get; set; } = [];

    /// <summary>Latitude, longitude pairs, oldest first. Drawn as a line when there are at least two.</summary>
    [Parameter]
    public IReadOnlyList<double[]>? Route { get; set; }

    /// <summary>Shorter map used beside a place search.</summary>
    [Parameter]
    public bool Mini { get; set; }

    /// <summary>Clicking or dragging the pin reports the new coordinates.</summary>
    [Parameter]
    public bool Pick { get; set; }

    [Parameter]
    public EventCallback<MapPick> Picked { get; set; }

    protected override void OnInitialized() => self = DotNetObjectReference.Create(this);

    [JSInvokable]
    public Task OnMapPicked(double latitude, double longitude) =>
        Picked.HasDelegate ? Picked.InvokeAsync(new MapPick(latitude, longitude)) : Task.CompletedTask;

    public void Dispose()
    {
        disposed = true;
        self?.Dispose();
        self = null;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (mapReady && !disposed)
        {
            await DrawAsync();
        }
    }

    private Task ShowPinsAsync(MapEventArgs args)
    {
        if (disposed)
        {
            return Task.CompletedTask;
        }

        mapReady = true;
        return DrawAsync();
    }

    private async Task DrawAsync()
    {
        if (map is null || disposed)
        {
            return;
        }

        int version = ++drawVersion;
        var pins = Pins.Select(pin => new
        {
            lat = pin.Latitude,
            lng = pin.Longitude,
            html = Mini ? string.Empty : $"<strong>{WebUtility.HtmlEncode(pin.FullName)}</strong><br/>{PopupContent(pin)}",
        }).ToList();
        var route = Route;
        var pick = Pick ? self : null;

        var pinsModule = await Js.InvokeAsync<IJSObjectReference>("import", "./js/map-pins.js?v=7");
        if (version != drawVersion || disposed)
        {
            return;
        }

        await pinsModule.InvokeVoidAsync("usePins", root, pins, route, pick);
    }

    private static string PopupContent(MapPinDto pin)
    {
        if (pin.Kind == MapPinKind.Event)
        {
            var lines = new List<string> { WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(pin.Detail) ? "Date unknown" : pin.Detail) };
            if (!string.IsNullOrWhiteSpace(pin.Place))
            {
                lines.Add(WebUtility.HtmlEncode(pin.Place));
            }

            if (!string.IsNullOrWhiteSpace(pin.Description))
            {
                lines.Add(WebUtility.HtmlEncode(pin.Description));
            }

            return string.Join("<br/>", lines);
        }

        if (pin.Kind == MapPinKind.Photo)
        {
            string image = string.IsNullOrWhiteSpace(pin.ProfileImagePath)
                ? string.Empty
                : $"<img src=\"/uploads/{pin.ProfileImagePath.TrimStart('/')}\" alt=\"\" style=\"display:block;max-width:160px;height:auto;border-radius:4px\" />";
            string date = string.IsNullOrWhiteSpace(pin.Detail) ? string.Empty : $"<div>{WebUtility.HtmlEncode(pin.Detail)}</div>";
            return image + date;
        }

        string portrait = string.IsNullOrWhiteSpace(pin.ProfileImagePath)
            ? string.Empty
            : $"<img src=\"/uploads/{pin.ProfileImagePath.TrimStart('/')}\" alt=\"\" style=\"width:60px;height:60px;border-radius:50%;object-fit:cover\" /><br/>";
        return $"{portrait}<a href=\"/people/{pin.PersonId}\">View Profile</a>";
    }
}
