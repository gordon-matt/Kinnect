@page "/admin/backups"
@attribute [Authorize(Roles = Constants.Roles.Administrator)]
@using Kinnect.Models.Dto.Admin

@inject IPersonBackupService Backups
@inject ToastService Toasts

<PageTitle>Person backups</PageTitle>
<PageHeader Title="Person backups">
    <Actions>
        <button class="nf-button nf-button-primary" type="button" @onclick="ExportAsync">Back up now</button>
    </Actions>
</PageHeader>

@if (files is null)
{
    <p>Loading…</p>
}
else if (files.Count == 0)
{
    <EmptyState Title="No backups yet" Description="The weekly job writes one here, or you can take one now." />
}
else
{
    <ul class="kinnect-list">
        @foreach (var file in files)
        {
            <li>
                <span>@file.FileName <small class="kinnect-muted">@file.CreatedUtc.ToLocalTime().ToString("g")</small></span>
                <button class="nf-button nf-button-sm nf-button-danger" type="button" @onclick="() => RestoreAsync(file.FileName)">Restore</button>
            </li>
        }
    </ul>
}

@code {
    private List<PersonBackupFileDto>? files;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Backups.ListBackupsAsync();
        files = result.IsSuccess ? result.Value.ToList() : [];
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
        }
    }

    private async Task ExportAsync()
    {
        await Backups.ExportToNewFileAsync();
        Toasts.Success("Backup written.");
        await LoadAsync();
    }

    private async Task RestoreAsync(string fileName)
    {
        var result = await Backups.RestoreFromFileAsync(fileName);
        if (result.IsSuccess)
        {
            Toasts.Success("Restored.");
        }
        else
        {
            Toasts.ShowFailure(result);
        }
    }
}
