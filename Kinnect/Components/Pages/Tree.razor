@page "/tree"
@attribute [Authorize]
@using MyWebTree.Components
@using System.Text.Json
@using Kinnect.Data.Entities
@using MyWebTree
@using MyWebTree.Models

@inject KinnectFamilyGraph Graph
@inject IUserContextService Users
@inject NavigationManager Nav
@inject ToastService Toasts
@inject ISettingsService Settings
@inject IJSRuntime JS
@inject ILogger<Tree> Logger

<PageTitle>Family tree</PageTitle>
<div class="kinnect-tree-page">
<PageHeader Title="Family tree">
    <Actions>
        <button type="button" class="nf-button" aria-expanded="@showPeople" @onclick="() => showPeople = !showPeople">People</button>
        @if (Users.IsAdmin())
        {
            <button type="button" class="nf-button" @onclick="() => showExport = true">Export GEDCOM</button>
        }
        @if (meId is not null)
        {
            <button type="button" class="nf-button" @onclick="FindMeAsync">Find me</button>
        }
    </Actions>
</PageHeader>

@if (people is null || !viewLoaded)
{
    <p>Loading the family…</p>
}
else
{
    <div class="kinnect-tree-stage">
        <FamilyTree @ref="tree"
                    Theme="netforge"
                    People="people"
                    FocusPersonId="@focusId"
                    HighlightedPersonId="@highlightId"
                    Editable="@editable"
                    AncestryDepth="@view.Ancestry"
                    ProgenyDepth="@view.Progeny"
                    ShowSiblings="@view.ShowSiblings"
                    Lineage="@view.Lineage"
                    Orientation="@view.Orientation"
                    BloodRelativesOnly="@view.BloodRelativesOnly"
                    ActiveParentSets="@activeSets"
                    ActiveParentSetsChanged="OnActiveSetsChangedAsync"
                    MaxGenerations="@maxGenerations"
                    ViewChanged="OnViewChangedAsync"
                    Height="calc(100vh - 12rem)"
                    Changed="OnChanged"
                    OnOpenPerson="OnOpen"
                    OpenPersonText="View Profile" />
        <Drawer Inline Side="DrawerSide.Start" Persistent Open="showPeople" Title="People" OnClose="() => showPeople = false">
            <div class="kinnect-list">
                @foreach (var person in people.Where(person => !person.IsPlaceholder).OrderBy(person => person.DisplayName, StringComparer.OrdinalIgnoreCase))
                {
                    <button type="button" @onclick="() => CenterAsync(person.Id)">
                        <span class="kinnect-person-label">
                            @if (IsUnlinked(person))
                            {
                                <svg class="nf-icon kinnect-unlinked" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Not linked to anyone">
                                    <title>Not linked to anyone</title>
                                    <path d="M10 13a5 5 0 0 0 7.5.5l2-2a5 5 0 0 0-7-7l-1.2 1.2" />
                                    <path d="M14 11a5 5 0 0 0-7.5-.5l-2 2a5 5 0 0 0 7 7l1.2-1.2" />
                                    <path d="M4.5 4.5 19.5 19.5" />
                                </svg>
                            }
                            <span>@person.DisplayName</span>
                        </span>
                        @if (person.Lifespan.Length > 0)
                        {
                            <small class="kinnect-muted">@person.Lifespan</small>
                        }
                    </button>
                }
            </div>
        </Drawer>
    </div>
}
</div>

@if (showExport)
{
    <GedcomExportDialog Closed="() => showExport = false" />
}

@code {
    private FamilyTree? tree;
    private bool showExport;
    private IReadOnlyList<PersonData>? people;
    private string? focusId;
    private string? meId;
    private string? highlightId;
    private bool showPeople;
    private bool editable;
    private int? routedPerson;
    private bool routedSelectionApplied;

    // What the tree opens with until this person's saved toolbar choices are read from the browser.
    private const int DefaultDepth = 4;
    private TreeView view = new(DefaultDepth, DefaultDepth, false, LineageScope.Bilateral, TreeOrientation.Vertical);
    private int maxGenerations = TreeSettings.DefaultMaxGenerations;
    private bool viewLoaded;
    private string? viewKey;

    // Which family is drawn for a person who has more than one (adopted, birth, foster). It is only a view, so it is
    // remembered in this browser like the toolbar choices, and the sets in it are only ones this user can already see.
    private IReadOnlyDictionary<string, string> activeSets = new Dictionary<string, string>();
    private string? setsKey;

    [SupplyParameterFromQuery(Name = "person")]
    public int? PersonId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        editable = Users.IsAdmin() || Users.IsEditor();
        maxGenerations = (await Settings.GetAsync<TreeSettings>()).MaxGenerations;
        viewKey = $"kinnect.tree.view.{Users.GetCurrentUserId() ?? "anonymous"}";
        setsKey = $"kinnect.tree.sets.{Users.GetCurrentUserId() ?? "anonymous"}";
        NoteRoutedPerson();
        await ReloadAsync();
    }

    protected override async Task OnParametersSetAsync() => await FollowRoutedPersonAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Browser storage is out of reach while the page is prerendered, so the tree waits for this.
            await LoadViewAsync();
            viewLoaded = true;
            StateHasChanged();
            return;
        }

        await FollowRoutedPersonAsync();
    }

    private async Task LoadViewAsync()
    {
        try
        {
            string? stored = await JS.InvokeAsync<string?>("localStorage.getItem", viewKey);
            if (string.IsNullOrWhiteSpace(stored))
            {
                // Earlier builds only remembered the generation counts, under another key.
                stored = await JS.InvokeAsync<string?>("localStorage.getItem", viewKey!.Replace(".view.", ".depths.", StringComparison.Ordinal));
            }

            string? storedSets = await JS.InvokeAsync<string?>("localStorage.getItem", setsKey);
            if (!string.IsNullOrWhiteSpace(storedSets) && JsonSerializer.Deserialize<Dictionary<string, string>>(storedSets) is { } remembered)
            {
                activeSets = remembered;
            }

            if (!string.IsNullOrWhiteSpace(stored) && JsonSerializer.Deserialize<TreeView>(stored) is { } saved)
            {
                // The generation limit may have been lowered since this was saved.
                view = saved with
                {
                    Ancestry = Math.Clamp(saved.Ancestry, 0, maxGenerations),
                    Progeny = Math.Clamp(saved.Progeny, 0, maxGenerations),
                };
            }
        }
        catch (Exception ex) when (ex is JSException or JsonException or InvalidOperationException or JSDisconnectedException)
        {
            // Not being able to read the saved choices only means starting from the defaults.
            Logger.LogDebug(ex, "Could not read the saved tree view.");
        }
    }

    private async Task OnViewChangedAsync(TreeView changed)
    {
        view = changed with
        {
            Ancestry = Math.Clamp(changed.Ancestry, 0, maxGenerations),
            Progeny = Math.Clamp(changed.Progeny, 0, maxGenerations),
        };
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", viewKey, JsonSerializer.Serialize(view));
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException)
        {
            Logger.LogDebug(ex, "Could not save the tree view.");
        }
    }

    private async Task OnActiveSetsChangedAsync(IReadOnlyDictionary<string, string> chosen)
    {
        activeSets = chosen;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", setsKey, JsonSerializer.Serialize(chosen));
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException)
        {
            Logger.LogDebug(ex, "Could not save the chosen families.");
        }
    }

    private void NoteRoutedPerson()
    {
        if (PersonId is int id)
        {
            focusId = id.ToString();
        }
    }

    private async Task FollowRoutedPersonAsync()
    {
        if (PersonId is not int id)
        {
            return;
        }

        string key = id.ToString();
        if (routedPerson != id)
        {
            routedPerson = id;
            routedSelectionApplied = false;
            focusId = key;
        }

        if (routedSelectionApplied || tree is null || people is null)
        {
            return;
        }

        if (people.All(person => person.Id != key))
        {
            routedSelectionApplied = true;
            return;
        }

        routedSelectionApplied = true;
        await tree.CenterOnAsync(key);
    }

    private async Task ReloadAsync()
    {
        var snapshot = await Graph.LoadAsync();
        people = snapshot.People;
        meId = snapshot.FocusPersonId;
        focusId ??= snapshot.FocusPersonId;
        highlightId = snapshot.FocusPersonId;
    }

    /// <summary>A person with no parents, spouse or children. Hidden links do not count, because this list only holds what the viewer can see.</summary>
    private static bool IsUnlinked(PersonData person) =>
        person.Parents.Count == 0
        && person.ParentSets.Count == 0
        && person.Spouses.Count == 0
        && person.Children.Count == 0;

    private async Task CenterAsync(string personId)
    {
        showPeople = false;
        focusId = personId;
        if (tree is not null)
        {
            await tree.CenterOnAsync(personId);
        }
    }

    private Task FindMeAsync() => meId is null ? Task.CompletedTask : CenterAsync(meId);

    private async Task OnChanged(FamilyTreeChange change)
    {
        if (change.Kind != FamilyTreeChangeKind.FocusChanged)
        {
            var result = await Graph.ApplyAsync(change);
            if (!result.IsSuccess)
            {
                Toasts.ShowFailure(result);
            }

            await ReloadAsync();
        }
        else
        {
            focusId = change.FocusPersonId;
        }
    }

    private Task OnOpen(PersonData person)
    {
        if (int.TryParse(person.Id, out int id))
        {
            Nav.NavigateTo($"/people/{id}");
        }

        return Task.CompletedTask;
    }
}
