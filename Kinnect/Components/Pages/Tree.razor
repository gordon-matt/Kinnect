@page "/tree"
@attribute [Authorize]
@using MyWebTree.Components
@using MyWebTree.Models

@inject KinnectFamilyGraph Graph
@inject IUserContextService Users
@inject NavigationManager Nav

<PageTitle>Family tree</PageTitle>
<PageHeader Title="Family tree">
    <Actions>
        <button type="button" class="btn btn-outline-secondary" aria-expanded="@showPeople" @onclick="() => showPeople = !showPeople">People</button>
        @if (meId is not null)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="FindMeAsync">Find me</button>
        }
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (people is null)
{
    <p>Loading the family…</p>
}
else
{
    <div class="kinnect-tree-stage">
        <FamilyTree @ref="tree"
                    Theme="bootstrap"
                    People="people"
                    FocusPersonId="@focusId"
                    HighlightedPersonId="@highlightId"
                    Editable="@editable"
                    Height="calc(100vh - 12rem)"
                    Changed="OnChanged"
                    OnOpenPerson="OnOpen" />
        <aside class="kinnect-people-drawer @(showPeople ? "is-open" : null)" aria-hidden="@(!showPeople)">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h5 mb-0">People</h2>
                <button type="button" class="btn-close" @onclick="() => showPeople = false"></button>
            </div>
            <div class="list-group">
                @foreach (var person in people.Where(person => !person.IsPlaceholder).OrderBy(person => person.DisplayName, StringComparer.OrdinalIgnoreCase))
                {
                    <button type="button" class="list-group-item list-group-item-action" @onclick="() => CenterAsync(person.Id)">
                        @person.DisplayName
                        @if (person.Lifespan.Length > 0)
                        {
                            <small class="text-secondary">@person.Lifespan</small>
                        }
                    </button>
                }
            </div>
        </aside>
    </div>
}

@code {
    private FamilyTree? tree;
    private IReadOnlyList<PersonData>? people;
    private string? focusId;
    private string? meId;
    private string? highlightId;
    private bool showPeople;
    private string? error;
    private bool editable;

    protected override async Task OnInitializedAsync()
    {
        editable = Users.IsAdmin() || Users.IsEditor();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var snapshot = await Graph.LoadAsync();
        people = snapshot.People;
        meId = snapshot.FocusPersonId;
        focusId ??= snapshot.FocusPersonId;
        highlightId = snapshot.FocusPersonId;
    }

    private async Task CenterAsync(string personId)
    {
        showPeople = false;
        focusId = personId;
        if (tree is not null)
        {
            await tree.CenterOnAsync(personId);
        }
    }

    private Task FindMeAsync() => meId is null ? Task.CompletedTask : CenterAsync(meId);

    private async Task OnChanged(FamilyTreeChange change)
    {
        error = null;
        if (change.Kind != FamilyTreeChangeKind.FocusChanged)
        {
            var result = await Graph.ApplyAsync(change);
            if (!result.IsSuccess)
            {
                error = string.Join(" ", result.Errors.Select(e => e));
            }

            await ReloadAsync();
        }
        else
        {
            focusId = change.FocusPersonId;
        }
    }

    private Task OnOpen(PersonData person)
    {
        if (int.TryParse(person.Id, out int id))
        {
            Nav.NavigateTo($"/people/{id}");
        }

        return Task.CompletedTask;
    }
}
