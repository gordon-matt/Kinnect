@page "/admin/settings"
@attribute [Authorize(Roles = Constants.Roles.Administrator)]
@using Kinnect.Data.Entities

@inject ISettingsService Settings
@inject IHostEnvironment HostEnvironment
@inject ILoggerFactory LoggerFactory
@inject ToastService Toasts

<PageTitle>Settings</PageTitle>
<PageHeader Title="Settings" />

<p class="kinnect-muted">
    Kinnect reads these from the database. If a section has never been saved, the values from appsettings.json or the
    docker compose environment are imported the first time they are needed, and after that the database wins.
</p>

@if (images is null || documents is null || videos is null || email is null || tree is null || backups is null)
{
    <p>Loading…</p>
}
else
{
    <ul class="kinnect-tabs">
        @foreach (var name in Tabs)
        {
            <li>
                <button type="button" class="@(tab == name ? "is-active" : null)" @onclick="() => tab = name">@name</button>
            </li>
        }
    </ul>

    <div class="kinnect-stack">
        @if (tab == "Images")
        {
        <EditForm Model="images" OnValidSubmit="SaveImagesAsync" class="kinnect-card kinnect-stack">
            <DataAnnotationsValidator />
            <label class="nf-check"><InputCheckbox @bind-Value="images.AutoShrinkImages" /> Shrink photos when they are uploaded</label>
            <div class="kinnect-pair">
                <Field Label="Max width (px)"><InputNumber class="nf-input" @bind-Value="images.MaxWidth" /></Field>
                <Field Label="Max height (px)"><InputNumber class="nf-input" @bind-Value="images.MaxHeight" /></Field>
            </div>
            <Field Label="JPEG quality (1 to 100)"><InputNumber class="nf-input" @bind-Value="images.Quality" /></Field>
            <div class="kinnect-pair">
                <Field Label="Thumbnail width (px)"><InputNumber class="nf-input" @bind-Value="images.ThumbnailWidth" /></Field>
                <Field Label="Thumbnail height (px)"><InputNumber class="nf-input" @bind-Value="images.ThumbnailHeight" /></Field>
            </div>
            <Field Label="Thumbnail quality (1 to 100)"><InputNumber class="nf-input" @bind-Value="images.ThumbnailQuality" /></Field>
            <ValidationSummary />
            <div><button class="nf-button nf-button-primary" type="submit">Save image settings</button></div>
        </EditForm>
        }
        else if (tab == "Documents")
        {
        <EditForm Model="documents" OnValidSubmit="SaveDocumentsAsync" class="kinnect-card kinnect-stack">
            <DataAnnotationsValidator />
            <Field Label="Allowed file extensions"><InputText class="nf-input" @bind-Value="documents.AllowedExtensions" />
                <small class="kinnect-muted">Comma separated, with the leading dot, for example .pdf,.jpg,.png</small>
            </Field>
            <Field Label="Largest upload (MB)"><InputNumber class="nf-input" @bind-Value="documentMaxMegabytes" />
            </Field>
            <label class="nf-check"><InputCheckbox @bind-Value="documents.AutoShrinkDocuments" /> Shrink uploaded images (PDF files are left alone)</label>
            <ValidationSummary />
            <div><button class="nf-button nf-button-primary" type="submit">Save document settings</button></div>
        </EditForm>
        }
        else if (tab == "Videos")
        {
        <EditForm Model="videos" OnValidSubmit="SaveVideosAsync" class="kinnect-card kinnect-stack">
            <DataAnnotationsValidator />
            <Field Label="FFmpeg tools folder"><InputText class="nf-input" @bind-Value="videos.ToolsPath" />
                <small class="kinnect-muted">Folder holding ffmpeg and ffprobe. Leave empty to look in the usual places, then download a copy.</small>
            </Field>
            <label class="nf-check"><InputCheckbox @bind-Value="videos.AutoShrinkVideos" /> Compress videos after they are uploaded</label>
            <Field Label="Maximum size"><InputSelect class="nf-select" @bind-Value="videos.OutputVideoSize">
                    @foreach (var size in VideoSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </InputSelect>
                <small class="kinnect-muted">Videos already inside this size stay as they are. A sideways one is turned upright and kept when the new file is not much larger. Bigger videos are shrunk to fit, and that result is discarded if it is not smaller than the original.</small>
            </Field>
            <div class="kinnect-pair">
                <Field Label="Quality (CRF, 0 to 51)"><InputNumber class="nf-input" @bind-Value="videos.Crf" />
                    <small class="kinnect-muted">Lower is better quality and a bigger file. 18 to 28 is sensible.</small>
                </Field>
                <Field Label="Audio bitrate (kbps)"><InputNumber class="nf-input" @bind-Value="audioKilobits" />
                </Field>
            </div>
            <ValidationSummary />
            <div><button class="nf-button nf-button-primary" type="submit">Save video settings</button></div>
        </EditForm>
        }
        else if (tab == "Email")
        {
        <EditForm Model="email" OnValidSubmit="SaveEmailAsync" class="kinnect-card kinnect-stack">
            <DataAnnotationsValidator />
            <div class="kinnect-pair">
                <Field Label="SMTP host"><InputText class="nf-input" @bind-Value="email.Host" /></Field>
                <Field Label="Port"><InputNumber class="nf-input" @bind-Value="email.Port" /></Field>
            </div>
            <label class="nf-check"><InputCheckbox @bind-Value="email.EnableSsl" /> Use SSL / TLS</label>
            <div class="kinnect-pair">
                <Field Label="Username"><InputText class="nf-input" @bind-Value="email.Username" autocomplete="off" /></Field>
                <Field Label="Password"><InputText class="nf-input" type="password" @bind-Value="newPassword" autocomplete="new-password"
                               placeholder="@(hasPassword ? "Saved. Type to replace it." : "")" />
                </Field>
            </div>
            @if (hasPassword)
            {
                <label class="nf-check"><InputCheckbox @bind-Value="removePassword" /> Remove the saved password</label>
            }
            <div class="kinnect-pair">
                <Field Label="From address"><InputText class="nf-input" @bind-Value="email.FromAddress" /></Field>
                <Field Label="From name"><InputText class="nf-input" @bind-Value="email.FromName" /></Field>
            </div>
            <small class="kinnect-muted">
                The password is kept in the database as typed and is never shown again here.
                @if (!email.IsConfigured)
                {
                    <text>Email is off until a host and a from address are saved.</text>
                }
            </small>
            <ValidationSummary />
            <div><button class="nf-button nf-button-primary" type="submit">Save email settings</button></div>
        </EditForm>
        }
        else if (tab == "Family tree")
        {
        <EditForm Model="tree" OnValidSubmit="SaveTreeAsync" class="kinnect-card kinnect-stack">
            <DataAnnotationsValidator />
            <Field>
<LabelContent>Most generations to show (1 to @TreeSettings.LargestMaxGenerations)</LabelContent>
<ChildContent><InputNumber class="nf-input" @bind-Value="tree.MaxGenerations" />
                <small class="kinnect-muted">Applies to ancestors and to descendants. Each person still picks their own number up to this limit.</small>
            </ChildContent>
</Field>
            <ValidationSummary />
            <div><button class="nf-button nf-button-primary" type="submit">Save tree settings</button></div>
        </EditForm>
        }
        else if (tab == "Backups")
        {
        <EditForm Model="backups" OnValidSubmit="SaveBackupsAsync" class="kinnect-card kinnect-stack">
            <DataAnnotationsValidator />
            <Field Label="Person backups to keep (0 to 100)"><InputNumber class="nf-input" @bind-Value="backups.KeepCount" />
                <small class="kinnect-muted">The newest files are kept. Zero keeps every backup. The weekly backup, and Back up now, remove older files before writing a new one.</small>
            </Field>
            <ValidationSummary />
            <div><button class="nf-button nf-button-primary" type="submit">Save backup settings</button></div>
        </EditForm>
        }
    </div>
}

@code {
    private static readonly string[] Tabs = ["Images", "Documents", "Videos", "Email", "Family tree", "Backups"];
    private static readonly string[] VideoSizes = Enum.GetNames<Xabe.FFmpeg.VideoSize>();

    private string tab = Tabs[0];

    private ImageSettings? images;
    private DocumentSettings? documents;
    private VideoSettings? videos;
    private EmailSettings? email;
    private TreeSettings? tree;
    private BackupSettings? backups;

    private string? newPassword;
    private bool hasPassword;
    private bool removePassword;

    // The database holds bytes, the page asks in friendlier units.
    private long documentMaxMegabytes
    {
        get => Math.Max(1, documents!.MaxFileSizeBytes / BytesPerMegabyte);
        set => documents!.MaxFileSizeBytes = value * BytesPerMegabyte;
    }

    private int audioKilobits
    {
        get => videos!.AudioBitrate / 1000;
        set => videos!.AudioBitrate = value * 1000;
    }

    private const long BytesPerMegabyte = 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        images = await Settings.GetAsync<ImageSettings>();
        documents = await Settings.GetAsync<DocumentSettings>();
        videos = await Settings.GetAsync<VideoSettings>();
        email = await Settings.GetAsync<EmailSettings>();
        tree = await Settings.GetAsync<TreeSettings>();
        backups = await Settings.GetAsync<BackupSettings>();
        RememberPassword();
    }

    private void RememberPassword()
    {
        hasPassword = !string.IsNullOrEmpty(email!.Password);
        newPassword = null;
        removePassword = false;
    }

    private async Task SaveImagesAsync()
    {
        var result = await Settings.SaveAsync(images!);
        if (result.IsSuccess)
        {
            images = result.Value;
            Toasts.Success("Image settings saved.");
        }
        else
        {
            Toasts.ShowFailure(result);
        }
    }

    private async Task SaveDocumentsAsync()
    {
        var result = await Settings.SaveAsync(documents!);
        if (result.IsSuccess)
        {
            documents = result.Value;
            Toasts.Success("Document settings saved.");
        }
        else
        {
            Toasts.ShowFailure(result);
        }
    }

    private async Task SaveVideosAsync()
    {
        string? previousToolsPath = (await Settings.GetAsync<VideoSettings>()).ToolsPath;
        var result = await Settings.SaveAsync(videos!);
        if (!result.IsSuccess)
        {
            Toasts.ShowFailure(result);
            return;
        }

        videos = result.Value;
        if (!string.Equals(previousToolsPath, videos.ToolsPath, StringComparison.Ordinal))
        {
            // The tools are located once at startup, so look again for the new folder.
            await FfmpegBootstrapper.EnsureConfiguredAsync(
                videos.ToolsPath,
                HostEnvironment,
                LoggerFactory.CreateLogger("Ffmpeg"));
        }

        Toasts.Success("Video settings saved.");
    }

    private async Task SaveEmailAsync()
    {
        // Leaving the box blank keeps what is stored.
        email!.Password = removePassword
            ? null
            : string.IsNullOrEmpty(newPassword) ? email.Password : newPassword;

        var result = await Settings.SaveAsync(email);
        if (result.IsSuccess)
        {
            email = result.Value;
            RememberPassword();
            Toasts.Success("Email settings saved.");
        }
        else
        {
            Toasts.ShowFailure(result);
        }
    }

    private async Task SaveTreeAsync()
    {
        var result = await Settings.SaveAsync(tree!);
        if (result.IsSuccess)
        {
            tree = result.Value;
            Toasts.Success("Tree settings saved.");
        }
        else
        {
            Toasts.ShowFailure(result);
        }
    }

    private async Task SaveBackupsAsync()
    {
        var result = await Settings.SaveAsync(backups!);
        if (result.IsSuccess)
        {
            backups = result.Value;
            Toasts.Success("Backup settings saved.");
        }
        else
        {
            Toasts.ShowFailure(result);
        }
    }
}
