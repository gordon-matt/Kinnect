@page "/messages"
@attribute [Authorize]
@using EasyChatz.Components
@using EasyChatz.Models

@inject NavigationManager Nav
@inject IPersonService People

<PageTitle>Messages</PageTitle>

<div class="kinnect-fill">
    <Chat Theme="netforge"
          Height="100%"
          WithUserId="@WithUser"
          OnOpenUser="OpenUser" />
</div>

@code {
    [SupplyParameterFromQuery(Name = "withUser")]
    public string? WithUser { get; set; }

    private async Task OpenUser(ChatPresenceDto person)
    {
        var linked = await People.GetByUserIdAsync(person.UserId);
        if (linked.IsSuccess)
        {
            Nav.NavigateTo($"/people/{linked.Value.Id}");
        }
    }
}
