    private async Task SaveSpouseAsync(SpouseForm row)
    {
        string? userId = Users.GetCurrentUserId();
        if (userId is null)
        {
            return;
        }

        var request = new PersonSpouseUpdateRequest
        {
            HasEngagement = row.HasEngagement,
            EngagementYear = row.HasEngagement ? ParseYear(row.EngagementYear) : null,
            EngagementMonth = row.HasEngagement ? ParseByte(row.EngagementMonth, 1, 12) : null,
            EngagementDay = row.HasEngagement ? ParseByte(row.EngagementDay, 1, 31) : null,
            HasMarriage = row.HasMarriage,
            MarriageYear = row.HasMarriage ? ParseYear(row.MarriageYear) : null,
            MarriageMonth = row.HasMarriage ? ParseByte(row.MarriageMonth, 1, 12) : null,
            MarriageDay = row.HasMarriage ? ParseByte(row.MarriageDay, 1, 31) : null,
            HasDivorce = row.HasDivorce,
            DivorceYear = row.HasDivorce ? ParseYear(row.DivorceYear) : null,
            DivorceMonth = row.HasDivorce ? ParseByte(row.DivorceMonth, 1, 12) : null,
            DivorceDay = row.HasDivorce ? ParseByte(row.DivorceDay, 1, 31) : null,
        };

        var result = await People.UpdateSpouseRelationshipAsync(
            PersonId, row.SpousePersonId, request, userId, Users.IsAdmin(), Users.IsAdmin() || Users.IsEditor());
        Notify(result, "Spouse dates saved.");
        if (result.IsSuccess)
        {
            var spouseResult = await People.GetSpousesForPersonAsync(PersonId);
            spouses = spouseResult.Value?.ToList() ?? [];
            spouseForms = spouses.Select(SpouseForm.From).ToList();
        }
    }

    private static string DateText(short? year, byte? month, byte? day) =>
        year is null ? "Date unknown" : month is not null && day is not null ? $"{year:D4}-{month:D2}-{day:D2}" : $"{year:D4}";

    private static int SortKey(short? year, byte? month, byte? day) =>
        ((year ?? 9999) * 10000) + ((month ?? 0) * 100) + (day ?? 0);

    private sealed record TimelineRow(int? EventId, string EventType, string Label, string? DateDisplay, string? Place, string? Description, int Sort);

    private RenderFragment CardMenu(string key, Action edit, Action? annotate, Func<Task> delete, bool includeAnnotate) => @<div class="kinnect-card-menu @(cardMenu == key ? "is-open" : null)">
        <button type="button" class="kinnect-card-menu-toggle" title="Actions" aria-label="Actions" @onclick="() => cardMenu = cardMenu == key ? null : key" @onclick:stopPropagation="true">
            <Icon Name="dots" Size="16" />
        </button>
        @if (cardMenu == key)
        {
            <div class="nf-menu-scrim" @onclick="() => cardMenu = null"></div>
            <div class="nf-menu-list" role="menu">
                <button type="button" class="nf-menu-item" role="menuitem" @onclick="() => { cardMenu = null; edit(); }"><Icon Name="edit" Size="16" /> Edit</button>
                @if (includeAnnotate && annotate is not null)
                {
                    <button type="button" class="nf-menu-item" role="menuitem" @onclick="() => { cardMenu = null; annotate(); }"><Icon Name="edit" Size="16" /> Annotate</button>
                }
                <button type="button" class="nf-menu-item" role="menuitem" @onclick="async () => { cardMenu = null; await delete(); }"><Icon Name="trash" Size="16" /> Delete</button>
            </div>
        }
    </div>;

    private sealed class SpouseForm
    {
        public int SpousePersonId { get; init; }

        public string FullName { get; init; } = "";

        public bool HasEngagement { get; set; }

        public string EngagementYear { get; set; } = "";

        public string EngagementMonth { get; set; } = "";

        public string EngagementDay { get; set; } = "";

        public bool HasMarriage { get; set; }

        public string MarriageYear { get; set; } = "";

        public string MarriageMonth { get; set; } = "";

        public string MarriageDay { get; set; } = "";

        public bool HasDivorce { get; set; }

        public string DivorceYear { get; set; } = "";

        public string DivorceMonth { get; set; } = "";

        public string DivorceDay { get; set; } = "";

        public static SpouseForm From(PersonSpouseDetailDto spouse) => new()
