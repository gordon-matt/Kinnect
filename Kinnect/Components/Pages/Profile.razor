    private IReadOnlyList<MapPinDto> ProfilePins
    {
        get
        {
            if (person is null)
            {
                return [];
            }

            double? latitude = Editing ? form.Latitude : person.Latitude;
            double? longitude = Editing ? form.Longitude : person.Longitude;
            if (latitude is null || longitude is null)
            {
                return [];
            }

            return
            [
                new MapPinDto
                {
                    PersonId = person.Id,
                    FullName = person.FullName,
                    Latitude = latitude.Value,
                    Longitude = longitude.Value,
                },
            ];
        }
    }

