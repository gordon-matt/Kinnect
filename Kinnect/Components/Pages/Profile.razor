@page "/people/{PersonId:int}"
@page "/people/{PersonId:int}/edit"
@attribute [Authorize]
@implements IDisposable

@inject IPersonService People
@inject IPersonEventService Events
@inject IPostService Posts
@inject IPhotoService Photos
@inject IVideoService Videos
@inject IDocumentService Documents
@inject IUserContextService Users
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject ToastService Toasts

<PageTitle>@(person?.FullName ?? "Profile")</PageTitle>

@if (missing)
{
    <EmptyState Title="Person not found" />
}
else if (person is null)
{
    <p>Loading…</p>
}
else
{
    <PageHeader Title="@person.FullName">
        <Actions>
            <a class="nf-button" href="@($"tree?person={PersonId}")">View on tree</a>
            @if (canEdit && !Editing)
            {
                <a class="nf-button nf-button-primary" href="@($"people/{PersonId}/edit")">Edit</a>
            }
            <a class="nf-button" href="@($"people/{PersonId}/events/map")">Event map</a>
            <a class="nf-button" href="@($"people/{PersonId}/photos/map")">Photo map</a>
        </Actions>
    </PageHeader>

    <ul class="kinnect-tabs">
        @foreach (var name in new[] { "About", "Posts", "Timeline", "Photos", "Videos", "Documents" })
        {
            <li>
                <button type="button" class="@(tab == name ? "is-active" : null)" @onclick="() => SelectTab(name)">@name</button>
            </li>
        }
    </ul>

    @if (tab == "About")
    {
        <div class="kinnect-columns">
            <div>
                @if (Editing)
                {
                    <EditForm Model="form" OnValidSubmit="SaveAsync" class="kinnect-card kinnect-stack">
                        <div class="kinnect-pair">
                            <label class="nf-field">Given names <InputText class="nf-input" @bind-Value="form.GivenNames" /></label>
                            <label class="nf-field">Family name <InputText class="nf-input" @bind-Value="form.FamilyName" /></label>
                        </div>
                        <div class="kinnect-switch" role="group" aria-label="Sex">
                            <button type="button" class="@(form.IsMale ? "is-active" : null)" aria-pressed="@form.IsMale" @onclick="() => form.IsMale = true">Male</button>
                            <button type="button" class="@(!form.IsMale ? "is-active" : null)" aria-pressed="@(!form.IsMale)" @onclick="() => form.IsMale = false">Female</button>
                        </div>
                        <label class="nf-field">Bio <InputTextArea class="nf-textarea" @bind-Value="form.Bio" /></label>
                        <label class="nf-field">Occupation <InputText class="nf-input" @bind-Value="form.Occupation" /></label>
                        <label class="nf-field">Education <InputText class="nf-input" @bind-Value="form.Education" /></label>
                        <label class="nf-field">Religion <InputText class="nf-input" @bind-Value="form.Religion" /></label>
                        <label class="nf-field">Notes <InputTextArea class="nf-textarea" @bind-Value="form.Note" /></label>
                        @if (!mine)
                        {
                            <label class="nf-check">
                                <InputCheckbox @bind-Value="form.IsDeceased" /> Deceased
                            </label>
                        }
                        <div class="kinnect-row">
                            <button class="nf-button nf-button-primary" type="submit">Save</button>
                            <a class="nf-button" href="@($"people/{PersonId}")">Cancel</a>
                        </div>
                    </EditForm>
                    @SpouseRelationships
                }
                else
                {
                    <div class="kinnect-card">
                        @if (!string.IsNullOrWhiteSpace(person.ProfileImagePath) || person.Links.Count > 0)
                        {
                            <div class="kinnect-profile-head">
                                @if (!string.IsNullOrWhiteSpace(person.ProfileImagePath))
                                {
                                    <img src="@MediaUrl(person.ProfileImagePath)" alt="" />
                                }
                                @if (person.Links.Count > 0)
                                {
                                    <div class="kinnect-profile-links">
                                        <h2>Links</h2>
                                        <ul>
                                            @foreach (var link in person.Links)
                                            {
                                                <li><a href="@link.Url" target="_blank" rel="noopener noreferrer">@link.Name</a></li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        }
                        <p>@person.Bio</p>
                        <p>@person.Occupation</p>
                        <p>@person.Education</p>
                        <p>@person.Religion</p>
                        <p>@person.Note</p>
                    </div>
                    @SpouseRelationships
                }
            </div>
            <div class="kinnect-stack">
                @if (canEdit)
                {
                    <div class="kinnect-card kinnect-stack">
                        <h2>Profile picture</h2>
                        @if (!string.IsNullOrWhiteSpace(person.ProfileImagePath))
                        {
                            <img class="kinnect-profile-picture" src="@MediaUrl(person.ProfileImagePath)" alt="" />
                        }
                        <FileUpload Url="@($"/api/people/{PersonId}/profile-image")" Accept="image/*" Label="Upload picture" Uploaded="OnPictureUploaded" />
                    </div>
                }
                @if (Editing)
                {
                    <div class="kinnect-card kinnect-stack">
                        <h2>Location</h2>
                        <div>@form.Latitude, @form.Longitude</div>
                        <PlaceSearch Selected="OnPlace" />
                        <KinnectMap Mini="true" Pick="true" Pins="ProfilePins" Picked="OnProfileMapPick" />
                    </div>
                    <div class="kinnect-card kinnect-stack">
                        <div class="kinnect-split">
                            <h2>Links</h2>
                            <button type="button" class="nf-button nf-button-sm" @onclick="AddLink">Add link</button>
                        </div>
                        @foreach (var link in form.Links ?? [])
                        {
                            <div class="kinnect-link-row">
                                <input class="nf-input" @bind="link.Name" placeholder="Name" />
                                <input class="nf-input" @bind="link.Url" placeholder="https://" />
                                <button type="button" class="nf-icon-button" title="Remove link" @onclick="() => RemoveLink(link)"><Icon Name="x" Size="16" /></button>
                            </div>
                        }
                    </div>
                }
                else if (ProfilePins.Count > 0)
                {
                    <div class="kinnect-card">
                        <KinnectMap Pins="ProfilePins" />
                    </div>
                }
            </div>
        </div>
    }
    else if (tab == "Posts")
    {
        @if (canEdit && mine)
        {
            <div class="kinnect-card kinnect-stack">
                <textarea class="nf-textarea" rows="3" @bind="postText" placeholder="Write a post"></textarea>
                <button class="nf-button nf-button-primary" type="button" @onclick="AddPostAsync">Post</button>
            </div>
        }
        @foreach (var post in posts)
        {
            <article class="kinnect-card">
                <small class="kinnect-muted">@post.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy HH:mm")</small>
                <p>@post.Content</p>
            </article>
        }
    }
    else if (tab == "Timeline")
    {
        <div class="kinnect-columns">
            <ul class="kinnect-list">
                @foreach (var item in TimelineRows)
                {
                    <li>
                        <div class="kinnect-event">
                            <div class="kinnect-event-title">
                                <span class="kinnect-row">
                                    <Icon Name="@EventIcon(item.EventType)" />
                                    <strong>@item.Label</strong>
                                    @if (canEdit && item.EventId is int eventId)
                                    {
                                        <button type="button" class="nf-icon-button kinnect-event-edit" title="Edit event" @onclick="() => BeginEditEvent(eventId)">
                                            <Icon Name="edit" Size="14" />
                                        </button>
                                        @if (PersonEventType.CanCopyToRelatives(item.EventType) && relatives.Count > 0)
                                        {
                                            <button type="button" class="nf-icon-button kinnect-event-edit" title="Copy to relatives" @onclick="() => BeginCopyEvent(eventId)">
                                                <Icon Name="copy" Size="14" />
                                            </button>
                                        }
                                        <button type="button" class="nf-icon-button kinnect-event-edit" title="Delete event" @onclick="() => DeleteEventAsync(eventId)">
                                            <Icon Name="trash" Size="14" />
                                        </button>
                                    }
                                </span>
                                <span class="kinnect-muted">@item.DateDisplay</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="kinnect-event-line"><Icon Name="logs" Size="14" /> <span>@item.Description</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Place))
                            {
                                <div class="kinnect-event-line"><Icon Name="pin" Size="14" /> <span>@item.Place</span></div>
                            }
                        </div>
                    </li>
                }
            </ul>
            @if (canEdit)
            {
                @if (CopyingEvent is PersonEventDto copying)
                {
                    <div class="kinnect-card kinnect-stack">
                        <h2>Copy to relatives</h2>
                        <p><strong>@copying.EventTypeLabel</strong> <span class="kinnect-muted">@copying.DateDisplay</span></p>
                        @CopyChecklist(rowCopyTargets)
                        <div class="kinnect-row">
                            <button type="button" class="nf-button nf-button-primary" disabled="@(rowCopyTargets.Count == 0)" @onclick="CopyExistingAsync">Copy</button>
                            <button type="button" class="nf-button" @onclick="CancelCopyEvent">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="kinnect-card kinnect-stack">
                        <h2>@(editingEventId is null ? "Add event" : "Edit event")</h2>
                        <select class="nf-select" @bind="eventForm.EventType">
                            @foreach (var option in PersonEventType.TimelineSelectableTypes)
                            {
                                <option value="@option.Type">@option.Label</option>
                            }
                        </select>
                        <div class="kinnect-row">
                            <input type="number" class="nf-input" @bind="eventYear" placeholder="Year" />
                            <input type="number" class="nf-input" @bind="eventMonth" placeholder="Month" min="1" max="12" />
                            <input type="number" class="nf-input" @bind="eventDay" placeholder="Day" min="1" max="31" />
                        </div>
                        <input class="nf-input" @bind="eventForm.Description" placeholder="Description" />
                        <input class="nf-input" @bind="eventForm.Place" placeholder="Place" />
                        <PlaceSearch Label="Event place" Selected="OnEventPlace" />
                        <KinnectMap Mini="true" Pick="true" Pins="EventPins" Picked="OnEventMapPick" />
                        <div class="kinnect-row">
                            <button class="nf-button nf-button-primary" type="button" @onclick="SaveEventAsync">@(editingEventId is null ? "Add event" : "Save")</button>
                            @if (editingEventId is not null)
                            {
                                <button class="nf-button" type="button" @onclick="CancelEditEvent">Cancel</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
    else if (tab == "Photos")
    {
        <div class="kinnect-profile-stage" @ref="mediaStage">
            <div class="kinnect-media-tools">
                <div class="kinnect-row">
                    <input class="nf-input" @bind="mediaQuery" @bind:event="oninput" placeholder="Search title, description, or tag" />
                    <select class="nf-select" @bind="photoPersonFilter">
                        <option value="">Anyone</option>
                        @foreach (var tagged in PhotoPeople)
                        {
                            <option value="@tagged.PersonId">@tagged.Name</option>
                        }
                    </select>
                </div>
                @if (canEdit && mine)
                {
                    <button type="button" class="nf-button nf-button-primary" @onclick="OpenAddPhoto">Add photo</button>
                }
            </div>
            @if (photos.Count > 0 && !VisiblePhotos.Any())
            {
                <p class="kinnect-muted">No matches.</p>
            }
            <div class="kinnect-media">
                @foreach (var photo in VisiblePhotos)
                {
                    <div class="kinnect-card kinnect-media-card">
                        <div class="kinnect-media-frame">
                            <button type="button" class="kinnect-media-open" @onclick="() => selectedPhoto = photo">
                                <img src="@MediaUrl(photo.ThumbnailPath ?? photo.FilePath)" alt="" />
                            </button>
                        </div>
                        <button type="button" class="kinnect-media-open" @onclick="() => selectedPhoto = photo">
                            <div>@photo.Title</div>
                        </button>
                        @if (photo.Tags.Count > 0)
                        {
                            <div class="kinnect-tags">
                                @foreach (var tag in photo.Tags)
                                {
                                    <span class="kinnect-tag">@tag</span>
                                }
                            </div>
                        }
                        @if (CanEditPhoto(photo))
                        {
                            @CardMenu($"photo-{photo.Id}", () => BeginEditPhoto(photo), () => selectedPhoto = photo, () => DeletePhotoAsync(photo), includeAnnotate: true)
                        }
                    </div>
                }
            </div>
            @if (drawer == DrawerKind.AddPhoto)
            {
                <aside class="kinnect-add-drawer kinnect-stack">
                    <div class="kinnect-split">
                        <h2>Add photo</h2>
                        <button type="button" class="nf-icon-button" title="Close" @onclick="CloseDrawer"><Icon Name="x" /></button>
                    </div>
                    <input class="nf-input" @bind="mediaTitle" placeholder="Title" />
                    <FileUpload Url="/api/photos" Accept="image/*" Label="Upload photo" Fields="@PhotoFields" Uploaded="OnUploaded" />
                </aside>
            }
            else if (drawer == DrawerKind.EditPhoto && editingPhoto is not null)
            {
                <aside class="kinnect-add-drawer kinnect-stack">
                    <div class="kinnect-split">
                        <h2>Edit photo</h2>
                        <button type="button" class="nf-icon-button" title="Close" @onclick="CloseDrawer"><Icon Name="x" /></button>
                    </div>
                    <label class="nf-field">Title <input class="nf-input" @bind="editTitle" /></label>
                    <label class="nf-field">Description <textarea class="nf-textarea" rows="2" @bind="editDescription"></textarea></label>
                    <div class="kinnect-row">
                        <input class="nf-input" @bind="editYear" placeholder="Year" />
                        <select class="nf-select" @bind="editMonth">
                            <option value="">Month</option>
                            @for (int month = 1; month <= 12; month++)
                            {
                                <option value="@month">@month</option>
                            }
                        </select>
                        <select class="nf-select" @bind="editDay">
                            <option value="">Day</option>
                            @for (int day = 1; day <= 31; day++)
                            {
                                <option value="@day">@day</option>
                            }
                        </select>
                    </div>
                    <label class="nf-field">Tags <input class="nf-input" @bind="editTags" placeholder="Comma-separated" /></label>
                    @if (editingPhoto.LatLongAcquiredFromExif)
                    {
                        <p class="kinnect-muted">Location comes from the photo and stays as @editingPhoto.Latitude, @editingPhoto.Longitude.</p>
                        <KinnectMap Mini="true" Pins="PhotoPins" />
                    }
                    else
                    {
                        <p class="kinnect-muted">Location: @editLatitude, @editLongitude</p>
                        <PlaceSearch Label="Photo place" Selected="OnPhotoPlace" />
                        <KinnectMap Mini="true" Pick="true" Pins="PhotoPins" Picked="OnPhotoMapPick" />
                    }
                    <p class="kinnect-lightbox-heading">Linked events</p>
                    <div class="kinnect-checks">
                        @foreach (var item in events)
                        {
                            <label class="nf-check">
                                <input type="checkbox" checked="@editEventIds.Contains(item.Id)" @onchange="args => ToggleLinkedEvent(item.Id, args.Value is true)" />
                                @item.EventTypeLabel @item.DateDisplay
                            </label>
                        }
                    </div>
                    <button type="button" class="nf-button nf-button-primary" @onclick="SavePhotoAsync">Save</button>
                </aside>
            }
        </div>
    }
    else if (tab == "Videos")
    {
        <div class="kinnect-profile-stage" @ref="mediaStage">
            <div class="kinnect-media-tools">
                <div class="kinnect-row">
                    <input class="nf-input" @bind="mediaQuery" @bind:event="oninput" placeholder="Search title, description, or tag" />
                </div>
                @if (canEdit && mine)
                {
                    <button type="button" class="nf-button nf-button-primary" @onclick="OpenAddVideo">Add video</button>
                }
            </div>
            @if (videos.Count > 0 && !VisibleVideos.Any())
            {
                <p class="kinnect-muted">No matches.</p>
            }
            <div class="kinnect-videos">
                @foreach (var video in VisibleVideos)
                {
                    <div class="kinnect-card kinnect-media-card">
                        <div class="kinnect-media-frame">
                            <button type="button" class="kinnect-media-open" @onclick="() => selectedVideo = video" disabled="@video.IsProcessing">
                                @if (!string.IsNullOrWhiteSpace(video.ThumbnailPath))
                                {
                                    <img src="@MediaUrl(video.ThumbnailPath)" alt="" />
                                }
                                else
                                {
                                    <div class="kinnect-video-poster"><Icon Name="film" Size="32" /></div>
                                }
                            </button>
                        </div>
                        <button type="button" class="kinnect-media-open" @onclick="() => selectedVideo = video" disabled="@video.IsProcessing">
                            <div>@(video.IsProcessing ? "Processing…" : video.Title)</div>
                        </button>
                        @if (video.Tags.Count > 0)
                        {
                            <div class="kinnect-tags">
                                @foreach (var tag in video.Tags)
                                {
                                    <span class="kinnect-tag">@tag</span>
                                }
                            </div>
                        }
                        @if (CanEditVideo(video))
                        {
                            @CardMenu($"video-{video.Id}", () => BeginEditVideo(video), null, () => DeleteVideoAsync(video), false)
                        }
                    </div>
                }
            </div>
            @if (drawer == DrawerKind.AddVideo)
            {
                <aside class="kinnect-add-drawer kinnect-stack">
                    <div class="kinnect-split">
                        <h2>Add video</h2>
                        <button type="button" class="nf-icon-button" title="Close" @onclick="CloseDrawer"><Icon Name="x" /></button>
                    </div>
                    <input class="nf-input" @bind="mediaTitle" placeholder="Title" />
                    <FileUpload Url="/api/videos" Accept="video/*" Label="Upload video" Fields="@VideoFields" Uploaded="OnUploaded" />
                </aside>
            }
            else if (drawer == DrawerKind.EditVideo && editingVideo is not null)
            {
                <aside class="kinnect-add-drawer kinnect-stack">
                    <div class="kinnect-split">
                        <h2>Edit video</h2>
                        <button type="button" class="nf-icon-button" title="Close" @onclick="CloseDrawer"><Icon Name="x" /></button>
                    </div>
                    <label class="nf-field">Title <input class="nf-input" @bind="editTitle" /></label>
                    <label class="nf-field">Description <textarea class="nf-textarea" rows="2" @bind="editDescription"></textarea></label>
                    <label class="nf-field">Tags <input class="nf-input" @bind="editTags" placeholder="Comma-separated" /></label>
                    <p class="kinnect-lightbox-heading">Linked events</p>
                    <div class="kinnect-checks">
                        @foreach (var item in events)
                        {
                            <label class="nf-check">
                                <input type="checkbox" checked="@editEventIds.Contains(item.Id)" @onchange="args => ToggleLinkedEvent(item.Id, args.Value is true)" />
                                @item.EventTypeLabel @item.DateDisplay
                            </label>
                        }
                    </div>
                    <button type="button" class="nf-button nf-button-primary" @onclick="SaveVideoAsync">Save</button>
                </aside>
            }
        </div>
    }
    else if (tab == "Documents")
    {
        <div class="kinnect-profile-stage" @ref="mediaStage">
            <div class="kinnect-media-tools">
                <div class="kinnect-row">
                    <input class="nf-input" @bind="mediaQuery" @bind:event="oninput" placeholder="Search title, description, or tag" />
                </div>
                @if (canEdit && mine)
                {
                    <button type="button" class="nf-button nf-button-primary" @onclick="OpenAddDocument">Add document</button>
                }
            </div>
            @if (documents.Count > 0 && !VisibleDocuments.Any())
            {
                <p class="kinnect-muted">No matches.</p>
            }
            <ul class="kinnect-list">
                @foreach (var document in VisibleDocuments)
                {
                    <li class="kinnect-doc">
                        <div>
                            <a href="@MediaUrl(document.FilePath)" target="_blank">@document.Title</a>
                            <div class="kinnect-muted">@document.ContentType</div>
                            @if (document.Tags.Count > 0)
                            {
                                <div class="kinnect-tags">
                                    @foreach (var tag in document.Tags)
                                    {
                                        <span class="kinnect-tag">@tag</span>
                                    }
                                </div>
                            }
                        </div>
                        @if (CanEditDocument(document))
                        {
                            @CardMenu($"document-{document.Id}", () => BeginEditDocument(document), null, () => DeleteDocumentAsync(document), false)
                        }
                    </li>
                }
            </ul>
            @if (drawer == DrawerKind.AddDocument)
            {
                <aside class="kinnect-add-drawer kinnect-stack">
                    <div class="kinnect-split">
                        <h2>Add document</h2>
                        <button type="button" class="nf-icon-button" title="Close" @onclick="CloseDrawer"><Icon Name="x" /></button>
                    </div>
                    <input class="nf-input" @bind="mediaTitle" placeholder="Title" />
                    <textarea class="nf-textarea" rows="2" @bind="mediaDescription" placeholder="Description"></textarea>
                    <input class="nf-input" @bind="mediaTags" placeholder="Tags, comma-separated" />
                    <FileUpload Url="/api/documents" Label="Upload document" Fields="@DocumentFields" Uploaded="OnUploaded" />
                </aside>
            }
            else if (drawer == DrawerKind.EditDocument && editingDocument is not null)
            {
                <aside class="kinnect-add-drawer kinnect-stack">
                    <div class="kinnect-split">
                        <h2>Edit document</h2>
                        <button type="button" class="nf-icon-button" title="Close" @onclick="CloseDrawer"><Icon Name="x" /></button>
                    </div>
                    <label class="nf-field">Title <input class="nf-input" @bind="editTitle" /></label>
                    <label class="nf-field">Description <textarea class="nf-textarea" rows="2" @bind="editDescription"></textarea></label>
                    <label class="nf-field">Tags <input class="nf-input" @bind="editTags" placeholder="Comma-separated" /></label>
                    <button type="button" class="nf-button nf-button-primary" @onclick="SaveDocumentAsync">Save</button>
                </aside>
            }
        </div>
    }

    @if (selectedPhoto is not null)
    {
        <PhotoLightbox ImageUrl="@MediaUrl(selectedPhoto.FilePath)"
                       Title="@selectedPhoto.Title"
                       Description="@selectedPhoto.Description"
                       AnnotationsJson="@selectedPhoto.AnnotationsJson"
                       PhotoId="@selectedPhoto.Id"
                       ShowPanel="true"
                       CanEdit="@CanEditPhoto(selectedPhoto)"
                       TaggedPeople="@selectedPhoto.TaggedPeople"
                       PeopleChanged="OnPeopleChanged"
                       AnnotationsSaved="OnAnnotationsSaved"
                       Closed="() => selectedPhoto = null" />
    }

    @if (selectedVideo is not null)
    {
        <div class="kinnect-lightbox" @onclick="() => selectedVideo = null">
            <div class="kinnect-card" @onclick:stopPropagation="true">
                <div class="kinnect-split">
                    <h2>@selectedVideo.Title</h2>
                    <button type="button" class="nf-icon-button" title="Close" @onclick="() => selectedVideo = null"><Icon Name="x" /></button>
                </div>
                <video controls autoplay src="@MediaUrl(selectedVideo.FilePath)"></video>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public int PersonId { get; set; }

    private PersonDto? person;
    private PersonEditRequest form = new();
    private PersonEventRequest eventForm = new() { EventType = PersonEventType.Birth };
    private int? editingEventId;
    private string? cardMenu;
    private List<PostDto> posts = [];
    private List<PersonEventDto> events = [];
    private List<PhotoDto> photos = [];
    private List<VideoDto> videos = [];
    private List<DocumentDto> documents = [];
    private PhotoDto? selectedPhoto;
    private VideoDto? selectedVideo;
    private string tab = "About";
    private string postText = string.Empty;
    private string mediaTitle = string.Empty;
    private string mediaDescription = string.Empty;
    private string mediaTags = string.Empty;
    private DrawerKind drawer = DrawerKind.None;
    private PhotoDto? editingPhoto;
    private VideoDto? editingVideo;
    private DocumentDto? editingDocument;
    private string editTitle = string.Empty;
    private string editDescription = string.Empty;
    private string editTags = string.Empty;
    private string editYear = string.Empty;
    private string editMonth = string.Empty;
    private string editDay = string.Empty;
    private double? editLatitude;
    private double? editLongitude;
    private HashSet<int> editEventIds = [];
    private string mediaQuery = string.Empty;
    private string photoPersonFilter = string.Empty;
    private ElementReference mediaStage;
    private IJSObjectReference? drawerModule;
    private IJSObjectReference? menuModule;
    private DrawerKind pinnedDrawer = DrawerKind.None;
