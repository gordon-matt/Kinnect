    private void BeginCopyEvent(int eventId)
    {
        CancelEditEvent();
        copyingEventId = eventId;
        rowCopyTargets.Clear();
    }

    private void CancelCopyEvent()
    {
        copyingEventId = null;
        rowCopyTargets.Clear();
    }

    private static void ToggleCopyTarget(HashSet<int> selected, int personId, bool include)
    {
        if (include)
        {
            selected.Add(personId);
        }
        else
        {
            selected.Remove(personId);
        }
    }

    private RenderFragment CopyChecklist(HashSet<int> selected) => @<div class="kinnect-checks kinnect-copy-list">
        @foreach (var relative in relatives)
        {
            <label class="nf-check">
                <input type="checkbox" checked="@selected.Contains(relative.PersonId)" @onchange="args => ToggleCopyTarget(selected, relative.PersonId, args.Value is true)" />
                <span>@relative.FullName</span>
                <span class="nf-badge">@relative.Relationship</span>
            </label>
        }
    </div>;

    private async Task CopyExistingAsync()
    {
        if (copyingEventId is not int eventId || rowCopyTargets.Count == 0)
        {
            return;
        }

        if (await CopyEventToRelativesAsync(eventId, rowCopyTargets.ToList()))
        {
            CancelCopyEvent();
        }
    }

    private async Task DeleteEventAsync(int eventId)
    {
        var item = events.FirstOrDefault(evt => evt.Id == eventId);
        string label = item?.EventTypeLabel ?? "this event";
        if (!await Js.InvokeAsync<bool>("confirm", $"Delete {label}?"))
        {
            return;
        }

        var result = await Events.DeleteAsync(eventId);
        Notify(result, "Event deleted.");
        if (result.Status != Ardalis.Result.ResultStatus.Ok)
        {
            return;
        }

        if (editingEventId == eventId)
        {
            CancelEditEvent();
        }

        if (copyingEventId == eventId)
        {
            CancelCopyEvent();
        }

        await ReloadAsync();
    }

    private async Task<bool> CopyEventToRelativesAsync(int eventId, IReadOnlyCollection<int> targets)
    {
        string? userId = Users.GetCurrentUserId();
        if (userId is null || targets.Count == 0)
        {
            return false;
        }

        var copied = await Events.CopyToCloseRelativesAsync(
            eventId, targets, userId, Users.IsAdmin(), Users.IsAdmin() || Users.IsEditor());
        if (!copied.IsSuccess)
        {
            Toasts.ShowFailure(copied);
            return false;
        }

        if (copied.Value == 0)
        {
            Toasts.Info("Those relatives already have this event.");
            return true;
        }

        Toasts.Success(copied.Value == 1 ? "Copied to 1 relative." : $"Copied to {copied.Value} relatives.");
        return true;
    }

    private void Notify(Ardalis.Result.IResult result, string success)
    {
        if (result.Status == Ardalis.Result.ResultStatus.Ok)
        {
            Toasts.Success(success);
        }
        else
        {
            Toasts.ShowFailure(result);
        }
    }
