    private IEnumerable<TimelineRow> TimelineRows
    {
        get
        {
            var rows = events.Select(item => new TimelineRow(
                item.Id,
                item.EventType,
                item.EventTypeLabel,
                item.DateDisplay,
                item.Place,
                item.Description,
                SortKey(item.Year, item.Month, item.Day))).ToList();

            foreach (var spouse in spouses)
            {
                if (spouse.EngagementYear is short engagementYear)
                {
                    rows.Add(new TimelineRow(
                        null,
                        PersonEventType.Engagement,
                        "Engagement",
                        DateText(engagementYear, spouse.EngagementMonth, spouse.EngagementDay),
                        null,
                        $"To {spouse.FullName}",
                        SortKey(engagementYear, spouse.EngagementMonth, spouse.EngagementDay)));
                }

                if (spouse.MarriageYear is short marriageYear)
                {
                    rows.Add(new TimelineRow(
                        null,
                        PersonEventType.Marriage,
                        "Marriage",
                        DateText(marriageYear, spouse.MarriageMonth, spouse.MarriageDay),
                        null,
                        $"To {spouse.FullName}",
                        SortKey(marriageYear, spouse.MarriageMonth, spouse.MarriageDay)));
                }

                if (spouse.DivorceYear is short divorceYear)
                {
                    rows.Add(new TimelineRow(
                        null,
                        PersonEventType.Divorce,
                        "Divorce",
                        DateText(divorceYear, spouse.DivorceMonth, spouse.DivorceDay),
                        null,
                        $"From {spouse.FullName}",
                        SortKey(divorceYear, spouse.DivorceMonth, spouse.DivorceDay)));
                }
            }

            return rows.OrderBy(row => row.Sort);
        }
    }

