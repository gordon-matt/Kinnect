            MarriageYear = spouse.MarriageYear?.ToString() ?? "",
            MarriageMonth = spouse.MarriageMonth?.ToString() ?? "",
            MarriageDay = spouse.MarriageDay?.ToString() ?? "",
            HasDivorce = spouse.HasDivorce,
            DivorceYear = spouse.DivorceYear?.ToString() ?? "",
            DivorceMonth = spouse.DivorceMonth?.ToString() ?? "",
            DivorceDay = spouse.DivorceDay?.ToString() ?? "",
        };
