    private async Task SavePhotoAsync()
    {
        if (editingPhoto is null)
        {
            return;
        }

        string? userId = Users.GetCurrentUserId();
        if (userId is null || string.IsNullOrWhiteSpace(editTitle))
        {
            return;
        }

        var request = new PhotoUpdateRequest
        {
            Title = editTitle.Trim(),
            Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim(),
            YearTaken = ParseYear(editYear),
            MonthTaken = ParseByte(editMonth, 1, 12),
            DayTaken = ParseByte(editDay, 1, 31),
            Tags = SplitTags(editTags),
            EventIds = editEventIds.ToList(),
            FolderId = editingPhoto.FolderId,
            Latitude = editingPhoto.LatLongAcquiredFromExif ? null : editLatitude,
            Longitude = editingPhoto.LatLongAcquiredFromExif ? null : editLongitude,
        };

        var result = await Photos.UpdateAsync(editingPhoto.Id, request, userId, Users.IsAdmin());
        Notify(result, "Photo saved.");
        if (result.IsSuccess)
        {
            drawer = DrawerKind.None;
            await ReloadAsync();
        }
    }

