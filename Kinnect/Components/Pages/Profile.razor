    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Editing)
        {
            tab = "About";
        }

        drawer = DrawerKind.None;
        await ReloadAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (Editing)
        {
            tab = "About";
        }

        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _ = drawerModule?.InvokeVoidAsync("release");
        _ = menuModule?.InvokeVoidAsync("release");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (drawer != pinnedDrawer)
        {
            drawerModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/drawer-pin.js?v=1");
            if (drawer == DrawerKind.None)
            {
                await drawerModule.InvokeVoidAsync("release");
            }
            else
            {
                await drawerModule.InvokeVoidAsync("pin", mediaStage);
            }

            pinnedDrawer = drawer;
        }

        if (cardMenu == placedMenu)
        {
            return;
        }

        menuModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./js/card-menu.js?v=1");
        if (cardMenu is null)
        {
            await menuModule.InvokeVoidAsync("release");
        }
        else
        {
            await menuModule.InvokeVoidAsync("place");
        }

        placedMenu = cardMenu;
    }

