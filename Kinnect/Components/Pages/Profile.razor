    private async Task SaveAsync()
    {
        string? userId = Users.GetCurrentUserId();
        if (userId is null)
        {
            return;
        }

        var result = await People.UpdateAsync(PersonId, form, userId, Users.IsAdmin(), Users.IsAdmin() || Users.IsEditor());
        Notify(result, "Saved.");
        if (result.IsSuccess)
        {
            Nav.NavigateTo($"/people/{PersonId}");
        }
    }

    private void OnPlace(NominatimHit hit)
    {
        form.Latitude = hit.Latitude;
        form.Longitude = hit.Longitude;
    }

    private void OnEventPlace(NominatimHit hit)
    {
        eventForm.Place = hit.Label;
        eventForm.Latitude = hit.Latitude;
        eventForm.Longitude = hit.Longitude;
    }

    private async Task AddPostAsync()
    {
        if (string.IsNullOrWhiteSpace(postText) || person is null)
        {
            return;
        }

        await Posts.CreateAsync(new PostCreateRequest { Content = postText.Trim() }, person.Id);
        postText = string.Empty;
        await ReloadAsync();
    }

    private void BeginEditEvent(int eventId)
    {
        var item = events.FirstOrDefault(evt => evt.Id == eventId);
        if (item is null)
        {
            return;
        }

        CancelCopyEvent();
        editingEventId = eventId;
        eventForm = new PersonEventRequest
        {
            EventType = item.EventType,
            Year = item.Year,
            Month = item.Month,
            Day = item.Day,
            Place = item.Place,
            Latitude = item.Latitude,
            Longitude = item.Longitude,
            Description = item.Description,
            Note = item.Note,
        };
        eventYear = item.Year;
        eventMonth = item.Month;
        eventDay = item.Day;
    }

    private void CancelEditEvent()
    {
        editingEventId = null;
        eventForm = new PersonEventRequest { EventType = PersonEventType.Birth };
        eventYear = eventMonth = eventDay = null;
    }

    private void ApplyEventDate()
    {
        eventForm.Year = eventYear is int year and >= 1 and <= 9999 ? (short)year : null;
        eventForm.Month = eventMonth is int month and >= 1 and <= 12 ? (byte)month : null;
        eventForm.Day = eventDay is int day and >= 1 and <= 31 ? (byte)day : null;
    }

    private async Task SaveEventAsync()
    {
        ApplyEventDate();
        if (editingEventId is int eventId)
        {
            var result = await Events.UpdateAsync(eventId, eventForm);
            Notify(result, "Event saved.");
            if (result.IsSuccess)
            {
                CancelEditEvent();
                await ReloadAsync();
            }

            return;
        }

        var created = await Events.CreateAsync(PersonId, eventForm);
        Notify(created, "Event added.");
        if (created.IsSuccess)
        {
            CancelEditEvent();
            await ReloadAsync();
        }
    }

    private async Task DeletePhotoAsync(PhotoDto photo)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"Delete {photo.Title}?"))
        {
            return;
        }

        string? userId = Users.GetCurrentUserId();
        if (userId is null)
        {
            return;
        }

        var result = await Photos.DeleteAsync(photo.Id, userId, Users.IsAdmin());
        Notify(result, "Photo deleted.");
        if (result.IsSuccess)
        {
            if (selectedPhoto?.Id == photo.Id)
            {
                selectedPhoto = null;
