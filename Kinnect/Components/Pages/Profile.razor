    private static short? ParseYear(string text) =>
        short.TryParse(text, out short year) && year is >= 1 and <= 9999 ? year : null;

    private static byte? ParseByte(string text, int min, int max) =>
        byte.TryParse(text, out byte value) && value >= min && value <= max ? value : null;

    private static List<string> SplitTags(string text) =>
        text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

