@page "/people/{PersonId:int}/photos/map"
@attribute [Authorize]

@inject IPersonService People
@inject IPhotoService Photos

<PageTitle>Photo map</PageTitle>
<div class="kinnect-map-page">
    <PageHeader Title="@title" Description="@note" />

    @if (pins is null)
    {
        <p>Loading…</p>
    }
    else if (pins.Count == 0)
    {
        <EmptyState Title="No photo places" Description="Photos with coordinates will appear on this map." />
    }
    else
    {
        <KinnectMap Pins="pins" />
    }
</div>

@code {
    [Parameter]
    public int PersonId { get; set; }

    private string title = "Photo map";
    private string? note;
    private List<MapPinDto>? pins;

    protected override async Task OnInitializedAsync()
    {
        var person = await People.GetByIdAsync(PersonId);
        if (person.IsSuccess)
        {
            title = person.Value.FullName + " — photos";
        }

        var photos = await Photos.GetByPersonAsync(PersonId);
        if (!photos.IsSuccess)
        {
            pins = [];
            return;
        }

        int missing = photos.Value.Count(photo => photo.Latitude is null || photo.Longitude is null);
        note = missing == 0 ? null : missing == 1 ? "1 photo has no location." : $"{missing} photos have no location.";
        pins = photos.Value
            .Where(photo => photo.Latitude is not null && photo.Longitude is not null)
            .Select(photo => new MapPinDto
            {
                PersonId = PersonId,
                Kind = MapPinKind.Photo,
                FullName = photo.Title,
                Detail = photo.DateTakenDisplay,
                ProfileImagePath = photo.ThumbnailPath ?? photo.FilePath,
                Latitude = photo.Latitude!.Value,
                Longitude = photo.Longitude!.Value,
            })
            .ToList();
    }
}
