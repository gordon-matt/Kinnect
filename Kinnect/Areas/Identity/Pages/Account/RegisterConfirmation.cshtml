@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Registration submitted";
    Layout = "/Areas/Identity/Pages/Account/_Layout.cshtml";
}

<h1>Registration submitted</h1>
<p class="nf-hint">
    Your account has been created and is pending admin approval.
    An administrator will review your request and link your account to a family member record.
    You will be able to log in once your account is approved.
</p>
<a href="/auth/login" class="nf-button nf-button-primary nf-button-block">Go to login</a>
