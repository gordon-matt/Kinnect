@using Heroicsoft.NetForge.Components
@using Microsoft.Extensions.Options
@inject IOptions<ForgeUiOptions> UiOptions
@*
    Login is a Razor Page, rendered before a Blazor circuit exists, so it takes the NetForge
    stylesheet and theme script directly.
*@
@{
    var ui = UiOptions.Value;
    string? accentCss = ForgeAccentCss.Build(ui);
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kinnect</title>
    <script src="~/_content/Heroicsoft.NetForge.Components/js/theme-init.js"
            data-theme-key="@ui.ThemeStorageKey"
            data-default-theme="@ui.DefaultColorScheme"></script>
    <link rel="stylesheet" href="~/_content/Heroicsoft.NetForge.Components/css/nf.css" />
    @if (accentCss is not null)
    {
        <style>@Html.Raw(accentCss)</style>
    }
    <link rel="icon" type="image/png" href="~/img/Logo.png" />
</head>
<body>
    <div class="nf-standalone">
        <div class="nf-auth-card">
            <a class="nf-brand-link" href="/">
                <img class="nf-brand-logo nf-has-dark" src="~/img/Logo.png" alt="Kinnect" />
                <img class="nf-brand-logo-dark" src="~/img/Logo.png" alt="Kinnect" />
            </a>
            @RenderBody()
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
