<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<!--
		  LogVue's dashboard needs the framework's blazor.web.js. The Web SDK only restores that
		  file when this property is set on the host, and package props are not imported during
		  restore, so it has to be set here.
		-->
		<RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>aspnet-Kinnect-2a96d4b7-af17-411d-87aa-36a68600b70f</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<Version>1.0.3</Version>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Kinnect\**" />
		<Content Remove="Kinnect\**" />
		<EmbeddedResource Remove="Kinnect\**" />
		<None Remove="Kinnect\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Ardalis.Result.AspNetCore" Version="10.1.0" />
		<PackageReference Include="Heroicsoft.NetForge.Authentication" Version="1.0.3-beta" />
		<PackageReference Include="Heroicsoft.NetForge.Components" Version="1.0.3.1-beta" />
		<PackageReference Include="Heroicsoft.NetForge.Hangfire" Version="1.0.3-beta" />
		<PackageReference Include="Autofac" Version="9.1.0" />
		<PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.12" />
		<PackageReference Include="LeafletForBlazor" Version="4.0.4.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="LogVue" Version="1.0.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kinnect.Data\Kinnect.Data.csproj" />
		<ProjectReference Include="..\Kinnect.Data.Sqlite\Kinnect.Data.Sqlite.csproj" />
		<ProjectReference Include="..\Kinnect.Data.Sql\Kinnect.Data.Sql.csproj" />
		<ProjectReference Include="..\Kinnect.Data.Npgsql\Kinnect.Data.Npgsql.csproj" />
		<ProjectReference Include="..\Kinnect.Data.MySql\Kinnect.Data.MySql.csproj" />
		<ProjectReference Include="..\Kinnect.Models\Kinnect.Models.csproj" />
		<ProjectReference Include="..\Kinnect.Services\Kinnect.Services.csproj" />
		<ProjectReference Include="..\..\..\Components\MyWebTree\MyWebTree.Components\MyWebTree.Components.csproj" />
		<ProjectReference Include="..\..\..\Components\EasyChatz\EasyChatz.AspNetCore\EasyChatz.AspNetCore.csproj" />
		<ProjectReference Include="..\..\..\Components\EasyChatz\EasyChatz.Components\EasyChatz.Components.csproj" />
		<ProjectReference Include="..\..\..\Components\EasyChatz\EasyChatz.Data.Sqlite\EasyChatz.Data.Sqlite.csproj" />
		<ProjectReference Include="..\..\..\Components\EasyChatz\EasyChatz.Data.Sql\EasyChatz.Data.Sql.csproj" />
		<ProjectReference Include="..\..\..\Components\EasyChatz\EasyChatz.Data.Npgsql\EasyChatz.Data.Npgsql.csproj" />
