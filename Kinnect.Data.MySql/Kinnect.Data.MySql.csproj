<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Hangfire.Core" />
		<PackageReference Include="Hangfire.NetCore" />
		<PackageReference Include="Hangfire.Storage.MySql" />
		<!--
			Oracle's official EF Core provider. Pomelo.EntityFrameworkCore.MySql does not yet
			ship an EF Core 10 build, so we use MySql.EntityFrameworkCore (10.0.x targets EF
			Core 10 / .NET 10) instead.
		-->
		<PackageReference Include="LogVue.Data.MySql" />
		<PackageReference Include="MySql.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kinnect.Data\Kinnect.Data.csproj" />
	</ItemGroup>

</Project>
